rules_version = '2';
// Reglas de la base Firestore del proyecto utn---organizador (se pegan en Firebase → Firestore → Reglas).
// Cada usuario lee y escribe solo su documento, usuarios/{su uid}. El dueño de la página, además, puede leer todos
// (la lista de usuarios), sin poder modificarlos. En Firebase va su mail real; acá no, porque el repo es público.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.token.email_verified == true
                  && request.auth.token.email == "MAIL_DEL_DUEÑO";
    }
  }
}
