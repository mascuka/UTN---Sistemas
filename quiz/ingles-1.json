 "glosario": [
  {
   "t": "Frase nominal",
   "que": "Un grupo de palabras cuyo núcleo es un sustantivo. En inglés los modificadores van <b>antes</b> del núcleo; en español, después: se traduce de derecha a izquierda (<i>renewable energy sources</i> → fuentes de energía renovable).",
   "re": "Traducí al español"
  },
  {
   "t": "Vocabulario técnico",
   "que": "Las palabras que más se repiten en los textos: <i>issue</i> (tema), <i>trend</i> (tendencia), <i>supply</i> (suministro), <i>device</i> (dispositivo), <i>network</i> (red), <i>scarcity</i> (escasez).",
   "re": "¿Qué significa"
  },
  {
   "t": "Conector (nexo lógico)",
   "que": "Une dos ideas y dice cómo se relacionan. En el cuadro del parcial: traducción, tipo de relación, idea uno (antes) e idea dos (después).",
   "re": "conector"
  },
  {
   "t": "Relaciones lógicas",
   "que": "<b>Adición</b>: and, also, moreover. <b>Contraste</b>: but, however, although, whereas. <b>Causa</b>: because, since, due to. <b>Consecuencia</b>: so, therefore, this is why, as a result. <b>Condición</b>: if, unless. <b>Finalidad</b>: to, in order to. <b>Ejemplificación</b>: such as, for example. <b>Tiempo</b>: when, meanwhile.",
   "re": "relación"
  },
  {
   "t": "Antónimo",
   "que": "La palabra de significado <b>opuesto</b>. En el parcial te dan una palabra que no está en el texto y tenés que encontrar su opuesta en la línea que indican.",
   "re": "antónimo de"
  },
  {
   "t": "Prefijos y sufijos negativos",
   "que": "<b>un-</b> (unable), <b>in-</b> (incorrect), <b>im-</b> delante de p/b/m (impossible), <b>il-</b> delante de l (illegal), <b>ir-</b> delante de r (irregular), <b>dis-</b> (disconnected), <b>non-</b> (non-renewable). Sufijos: <b>-ful</b> (con) ↔ <b>-less</b> (sin): harmful ↔ harmless.",
   "re": "con un prefijo"
  },
